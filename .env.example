# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Bucket
S3_BUCKET=excel-files

# Optional: For MinIO or S3-compatible services
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Combine Mode Settings
CHUNK_PREFIX=100mb_chunk_           # Prefix for chunk files to combine
OUTPUT_FILE=100mb_combined.xlsx     # Output filename for combined file
PROCESSING_TIMEOUT=10m              # Timeout for processing (e.g., 5m, 10m, 1h)

# Profiling Configuration (Optional)
ENABLE_PPROF=false                  # Set to true to enable pprof HTTP server
PPROF_PORT=6060                     # Port for pprof HTTP server
CPU_PROFILE=                        # File path for CPU profile (leave empty to disable)
MEM_PROFILE=                        # File path for memory profile (leave empty to disable)
