# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Bucket and File
S3_BUCKET=excel-files
EXCEL_FILE_NAME=large-file.xlsx

# Optional: For MinIO or S3-compatible services
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Processing Mode
PROCESSING_MODE=read        # "read" (just process) or "chunk" (split into chunks and upload to S3)
PROCESSING_TIMEOUT=5m       # Timeout for processing (e.g., 5m, 10m, 1h)

# Profiling Configuration
ENABLE_PPROF=false          # Set to true to enable pprof HTTP server
PPROF_PORT=6060             # Port for pprof HTTP server
CPU_PROFILE=cpu.prof        # File path for CPU profile (leave empty to disable)
MEM_PROFILE=mem.prof        # File path for memory profile (leave empty to disable)
